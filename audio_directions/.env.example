ELEVENLABS_API_KEY=your_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_STT_MODEL_ID=scribe_v2

# Local ONNX wake detection needs no access key.
# Empty = pretrained "Hey Jarvis"; paths are relative to audio_directions/.
WAKE_MODEL_PATH=
WAKE_KEYWORD=hey_jarvis
# Higher threshold means fewer false activations, but more misses.
WAKE_THRESHOLD=0.6
VAD_SILENCE_SECONDS=0.9
VAD_MIN_SPEECH_SECONDS=0.25
VAD_MAX_SECONDS=30
VAD_NO_SPEECH_SECONDS=5
VAD_MODE=2
VOICE_BARGE_IN=false
