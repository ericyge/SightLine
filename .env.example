# Copy to .env (never commit .env). Mock mode needs no key.
PERCEPTRON_API_KEY=
PERCEPTRON_MODE=mock
FOV_H_DEGREES=65
DB_PATH=sightline.db

# Conversational layer (POST /api/chat). mock = keyword matching, no network, no keys.
# LLM_PROVIDER: mock | purple | openai_compat. Any LLM error/timeout falls back to keyword matching.
LLM_PROVIDER=mock
# Purple (nebulaONE): needs API access. List model ids with: python -m app.llm models
PURPLE_API_BASE=https://purple.uw.edu/api/external/v1
PURPLE_API_TOKEN=
PURPLE_MODEL=
# Any OpenAI-compatible server (stand-in until Purple access works)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
