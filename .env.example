# Copy to .env (never commit .env). Mock mode needs no key.
# Vision: PERCEPTRON_MODE=mock (default, fake detections) or live (real Perceptron, needs the key).
PERCEPTRON_MODE=mock
PERCEPTRON_API_KEY=
# Model id. Blank = perceptron-mk1, the one id Perceptron's docs confirm. Other ids (e.g. the SDK
# also knows perceptron-mk1.5, isaac-0.3-fast) are unconfirmed for your key: check with the probe script.
PERCEPTRON_MODEL=
# Seconds before a Perceptron call counts as "not seen". Blank = 2.
PERCEPTRON_TIMEOUT_S=
# Max /api/guide frames per second each phone sends (tune after measuring latency; 0.5 to 10).
GUIDE_MAX_FPS=3
FOV_H_DEGREES=65
DB_PATH=sightline.db

# Conversational layer (POST /api/chat). mock = keyword matching, no network, no keys.
# LLM_PROVIDER: mock | purple | gemini | openai_compat
# Preference order: purple -> gemini -> keyword. The chain starts at LLM_PROVIDER and falls through
# the later ones on any error, 3 s timeout or missing key, always ending at keyword matching.
#   LLM_PROVIDER=purple  tries purple, then gemini, then keyword
#   LLM_PROVIDER=gemini  tries gemini, then keyword
# Only the user's words, the last 6 turns, and item/alias/room names are ever sent to a provider.
LLM_PROVIDER=mock
# Purple (nebulaONE): needs API access. List model ids with: python -m app.llm models
PURPLE_API_BASE=https://purple.uw.edu/api/external/v1
PURPLE_API_TOKEN=
PURPLE_MODEL=
# Google Gemini via its OpenAI-compatible endpoint. Key from Google AI Studio.
# Blank GEMINI_BASE_URL = https://generativelanguage.googleapis.com/v1beta/openai (from Google's docs).
# Model names change; list what your key can use with: python -m app.llm models
# Measured on 2026-10-17 (short chat requests): gemini-3.5-flash-lite ~0.5-0.9 s and correct;
# gemini-3.8-flash ~2-3 s (too slow for the 3 s timeout) and 429 under load; 2.5 models returned 404.
#   GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=
# Any OpenAI-compatible server (stand-in until Purple access works)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Speech-to-text for the phone page. browser = the phone's built-in recognition (no keys).
# elevenlabs = the phone records a short WAV and the backend relays it to ElevenLabs
# (the audio leaves your machine to ElevenLabs only; it is never stored or logged).
# If ElevenLabs fails or the key is missing, the phone falls back to browser recognition.
STT_PROVIDER=browser
ELEVENLABS_API_KEY=
# Blank = scribe_v2 (the model id in ElevenLabs' docs; check them, names change)
ELEVENLABS_STT_MODEL=
ELEVENLABS_BASE_URL=

# Text-to-speech: how the phone speaks chat replies. browser = the phone's built-in voice (no keys).
# elevenlabs = the reply text goes to ElevenLabs and the phone plays the mp3 in your chosen voice.
# Needs ELEVENLABS_API_KEY (above) and ELEVENLABS_VOICE_ID. If ElevenLabs fails or takes too long
# (3 s on the server, 2.5 s on the phone) the phone speaks with its built-in voice instead.
TTS_PROVIDER=browser
# Voice id from your ElevenLabs account (Voices / My Voices).
ELEVENLABS_VOICE_ID=
# Blank = eleven_flash_v2_5 (low latency; used by kaustubh-branch but NOT shown on ElevenLabs' convert page,
# which documents eleven_multilingual_v2). Model names change: set this if the default is rejected.
ELEVENLABS_TTS_MODEL=
# Fast guidance cues ("Wallet at 2 o'clock", "Reach out now"):
#   cached = use the ElevenLabs voice only when that exact audio is already cached on the server
#            (the fixed cues "Reach out now", "Stopped.", "Lost it. Turn slowly left." are pre-rendered
#            at startup); everything else keeps the instant built-in voice.
#   never  = guidance always uses the built-in voice.
TTS_GUIDANCE=cached
