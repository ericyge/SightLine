# Copy to .env (never commit .env). Mock mode needs no key.
PERCEPTRON_API_KEY=
PERCEPTRON_MODE=mock
PERCEPTRON_MODEL=perceptron-mk1.5
PERCEPTRON_TIMEOUT_SECONDS=15
VISION_FRAME_MAX_PX=640
# Optional JSON manifest of cropped item reference photos (see docs/VISION.md).
PERCEPTRON_REFERENCES=
FOV_H_DEGREES=65
DB_PATH=sightline.db
