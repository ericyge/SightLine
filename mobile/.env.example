# Copy to .env. EXPO_PUBLIC_ values are baked into the app bundle: never put a secret here.
# Address of the Sightline backend as seen from the phone. You can also type it in the app.
#   Same Wi-Fi:  http://<your-laptop-LAN-IP>:8000   (start the backend with --host 0.0.0.0)
#   ngrok:       https://<subdomain>.ngrok-free.app   (ngrok http 8000)
EXPO_PUBLIC_API_BASE=
