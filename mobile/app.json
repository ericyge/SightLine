{
  "expo": {
    "name": "Sightline",
    "slug": "sightline",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "cameraPermission": "Allow Sightline to use your camera to help you find everyday objects.",
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Sightline to use your microphone so you can ask where your things are."
        }
      ],
      "expo-asset",
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Sightline to use motion sensors to keep the beeps pointing at your item as you turn."
        }
      ]
    ]
  }
}
